# URL de l'API backend.
# En dev : laisser commenté → l'app dérive l'URL de l'hôte courant (localhost ou LAN).
# En prod (Vercel) : définir l'URL Render du backend.
# Ex: VITE_API_URL=https://atelier-toki.onrender.com
# VITE_API_URL=

# Clé publique Stripe (sûre à exposer côté client, contrairement à la secret_key).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
